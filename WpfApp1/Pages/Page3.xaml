<Page x:Class="WpfApp1.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3">

    <Grid>
        <StackPanel>
            <TextBlock Text="Последний этап овформления заказа" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Имя" FontSize="14" HorizontalAlignment="Center"/>
            <TextBox x:Name="Name" Height="20" Width="100" Margin="5"/>
            <TextBlock Text="Телефон" FontSize="14" HorizontalAlignment="Center"/>
            <TextBox x:Name="Telephon" Height="20" Width="100" Margin="5"/>
            <TextBlock Text="Почта" FontSize="14" HorizontalAlignment="Center"/>
            <TextBox x:Name="Mail" Height="20" Width="100" Margin="5"/>
            
            <Button x:Name="ButtonSafe" Content="Оформить заказ" Width="120" Height="40" Click="ButtonSafe_Click"/>
        </StackPanel>
       
    </Grid>
</Page>
