<Page x:Class="WpfApp1.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button x:Name="Back" Content="Назад" FontSize="20" Width="100" Height="30" Grid.Row="2" Click="Back_Click"/>

        <ListBox x:Name="SborkaBx" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="0" SelectionChanged="SborkaBx_SelectionChanged" >
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="15, 5" Orientation="Horizontal">
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <TextBlock TextWrapping="Wrap" Text="{Binding name}" FontSize="25"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding author}" FontSize="20"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        
        <ListBox x:Name="Opis" Grid.Row="1" Visibility="Hidden">
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="15, 5" Orientation="Horizontal">
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <Image Height="100" Width="120" Source="{Binding basepart_.image}"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding basepart_.name}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding basepart_.price}" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
