<Page x:Class="WpfApp1.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3">

    <Grid>
        <StackPanel>
            <TextBlock Text="Машина мечты" Margin="5" FontSize="20"/>
            <TextBlock Text="Давайте определимся с оплатой" Margin="5" FontSize="14"/>
            <TextBlock Text="Введите процент первоначального взноса" Margin="5" FontSize="14"/>
            <TextBox x:Name="Procenttt" Height="20" Width="100" Margin="5"/>
            <TextBlock Text="Укажите срок кредита(в месяцах)" Margin="5" FontSize="14"/>
            <TextBox x:Name="Month" Height="20" Width="100" Margin="5"/>
            <Button x:Name="ButtonMath" Content="Рассчитать"  Click="ButtonMath_Click"/>
            <TextBlock Text="Сумма первоначального взноса =" Margin="5" FontSize="14"/>
            <TextBlock x:Name="OutputVsnos" Margin="5" Height="20" Width="100"/>
            <TextBlock Text="Сумма кредита =" Margin="5" FontSize="14"/>
            <TextBlock x:Name="OutputCredit" Margin="5" Height="20" Width="100"/>
            <TextBlock Text="Ежемесячный платеж =" Margin="5" FontSize="14"/>
            <TextBlock x:Name="OutputMoney" Margin="5" Height="20" Width="100"/>
            <StackPanel Orientation="Horizontal" Height="20">
                <Button x:Name="Button3GoBack" Content="Назад" Margin="580, 0, 0, 0" Click="Button3GoBack_Click"/>
                <Button x:Name="Button3GoForward" Content="Вперед" Margin="10, 0, 0, 0" Click="Button3GoForward_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
