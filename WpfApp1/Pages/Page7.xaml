<Page x:Class="WpfApp1.Pages.Page7"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page7">

    <Grid>
        <StackPanel>
            <TextBlock Text="{Binding sesions.Film.Name}" FontSize="20" Foreground="#215756" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding sesions.Date, StringFormat={}{0:d}}" FontSize="20" Foreground="#215756" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding sesions.Time}" FontSize="20" Foreground="#215756" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding sesions.Hall.ClassHall.Class}" FontSize="20" Foreground="#215756" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding sessio.Place.Nomber}" FontSize="20" Foreground="#215756" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock Text="Итого:" FontSize="20" Foreground="#215756" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock Text="549" FontSize="20" Foreground="#215756" Margin="5" HorizontalAlignment="Center"/>
            <Button x:Name="BYE" Content="Оформить билет" Margin="5" Width="110" Height="40" HorizontalAlignment="Center" Click="BYE_Click"/>
            <Button x:Name="BackToMain" Content="Отказ" Width="80" Height="40" HorizontalAlignment="Right" Click="BackToMain_Click"/>
        </StackPanel>
    </Grid>
</Page>
