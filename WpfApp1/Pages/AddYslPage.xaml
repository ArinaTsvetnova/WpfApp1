<Page x:Class="WpfApp1.Pages.AddYslPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddYslPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Добавление услуги" FontSize="30" Margin="10" Grid.Row="0"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Back" Grid.Row="0" Content="Назад" Height="45" Width="120" FontSize="25" HorizontalAlignment="Right" Margin="10" Click="Back_Click"/>
            <Button x:Name="Start" Grid.Row="0" Content="На главную" Height="45" Width="150" FontSize="24" HorizontalAlignment="Right" Margin="10" Click="Start_Click"/>
        </StackPanel>
        <TextBlock Text="Название:" Margin="5" FontSize="25" Grid.Row="1"/>
        <TextBox x:Name="Name" Grid.Row="1" Margin="5" Height="25" Width="250"/>
        <TextBlock Text="Стоимость:" Margin="5" FontSize="25" Grid.Row="2"/>
        <TextBox x:Name="Price" Grid.Row="2" Margin="5" Height="25" Width="250"/>
        <TextBlock Text="Продолжительность:" Margin="5" FontSize="25" Grid.Row="3"/>
        <TextBox x:Name="Time" Grid.Row="3" Margin="5" Height="25" Width="250"/>
        <Button x:Name="Add" Content="Добавить" Grid.Row="4" FontSize="25" Height="35" Width="150" Margin="5" Click="Add_Click"/>
    </Grid>
</Page>
