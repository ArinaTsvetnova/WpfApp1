<Page x:Class="WpfApp1.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Интернет-магазин «Кружки у подружки»" FontSize="20" HorizontalAlignment="Center" Grid.RowSpan="1"/>
        <ListBox x:Name="ProductListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0, 50, 0, 0" Grid.RowSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="250" Height="400">
                        <Image Source="{Binding immage}" />
                        <TextBlock Text="{Binding name}"/>
                        <TextBlock Text="{Binding price}"/>
                        <Button x:Name="Buy" Content="Купить" Width="90" Height="40" Click="ButtonBuy_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Button x:Name="ButtonGoForward" Content="Вперед" Width="90" Height="40" Click="ButtonGoForward_Click"  Grid.Row="3"/>

    </Grid>
</Page>
