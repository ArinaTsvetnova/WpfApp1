<Page x:Class="WpfApp1.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Фильмы в шоке" FontSize="40" Foreground="#215756" HorizontalAlignment="Center" Grid.Row="0"/>
        <Button Content="Вход" Height="40" Width="100" FontSize="20" Margin="690, 5, 10, 5" Click="ButtonEntry_Click" Grid.Row="0"/>
        <ComboBox x:Name="Sort" Height="40" Width="115" Margin="10, 5, 675, 5" Grid.Row="1" SelectionChanged="Sort_SelectionChanged"/>
        <TextBox x:Name="Poisc" FontSize="11" Foreground="#487994" Background="White" Height="40" Width="540" Grid.Row="1" TextChanged="Poisc_TextChanged"/>
        <ListBox x:Name="FilmListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="230" Height="450">
                        <Image Source="{Binding Image}" />
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Rating}"/>
                        <TextBlock Text="{Binding Date}"/>
                        <TextBlock Text="{Binding Age.Age1}"/>
                        <Button x:Name="Buy" Content="Подробнее" Width="90" Height="40" Click="ButtonBuy_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
