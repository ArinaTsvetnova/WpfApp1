<Page x:Class="WpfApp1.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d"
      Title="Page1" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <ProgressBar Height="15" Minimum="0" Maximum="100" Value="40"/>
            <StackPanel Orientation="Horizontal" Height="20" Margin="0, 410, 0, 0">
                <Button x:Name="Button1GoBack" Content="Назад" Margin="580, 0, 0, 0" Height="20" Width="100" Click="Button1GoBack_Click"/>
                <Button x:Name="Button1GoForward" Content="Вперед" Margin="10, 0, 0, 0" Height="20" Width="100" Click="Button1GoForward_Click"/>
            </StackPanel>
        </StackPanel>
        <Frame x:Name="FramePage1" Grid.Row="0" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
