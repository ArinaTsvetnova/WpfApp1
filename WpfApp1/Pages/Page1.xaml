<Page x:Class="WpfApp1.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="800"
      Title="Page1"
      Loaded="Page_Loaded">
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" Grid.ColumnSpan="2">
                <Button x:Name="Clear" Content="Очистить" FontSize="20" Margin="5" MinHeight="30" MinWidth="75" Click="Clear_Click"/>
                <TextBlock Text="Собери компьютер" Grid.Row="0" FontSize="40" HorizontalAlignment="Center" Width="360" Grid.ColumnSpan="2" Margin="50, 0"/>
                <Button x:Name="look" Content="Сборки" FontSize="20" Margin="5" MinHeight="30" MinWidth="75" Click="look_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <Grid Grid.Row="2" Grid.Column="1" Background="#D9DAD8" Margin="20, 5" >
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/image/image6.png" Height="60" HorizontalAlignment="Left" />
                        <TextBlock TextWrapping="Wrap" Text="Центральный процессор" FontSize="25" VerticalAlignment="Center"  HorizontalAlignment="Center" Margin="25, 5" />
                        <Button x:Name="Chois1" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="1"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="1" Background="#D9DAD8" Margin="20,5" >
                    <StackPanel  Orientation="Horizontal">
                        <Image Source="/image/image4.png" Height="70" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock TextWrapping="Wrap" Text="Материнская плата" FontSize="25" VerticalAlignment="Center" Grid.Row="3" Margin="15"/>
                    </StackPanel>
                    <Button x:Name="Chois2" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="4"/>
                </Grid>

                <Grid Grid.Row="4" Grid.Column="1" Background="#D9DAD8" Margin="20,5"  >
                    <StackPanel  Orientation="Horizontal">
                        <Image Source="/image/image7.png" Height="70" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock Text="Блок питания" FontSize="25" VerticalAlignment="Center" Grid.Row="3" Margin="15"/>
                    </StackPanel>
                    <Button x:Name="Chois3" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="6"/>
                </Grid>

                <Grid Grid.Row="5" Grid.Column="1" Background="#D9DAD8" Margin="20,5" >
                    <StackPanel  Orientation="Horizontal">
                        <Image Source="/image/image3.png" Height="70" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock Text="Корпус" FontSize="25" VerticalAlignment="Center" Grid.Row="3" Margin="15"/>
                    </StackPanel>
                    <Button x:Name="Chois4" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="5"/>
                </Grid>

                <Grid Grid.Row="6" Grid.Column="1" Background="#D9DAD8" Margin="20,5" >
                    <StackPanel  Orientation="Horizontal">
                        <Image Source="/image/image8.png" Height="70" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock Text="Куллер" FontSize="25" VerticalAlignment="Center" Grid.Row="3" Margin="15"/>
                    </StackPanel>
                    <Button x:Name="Chois5" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="7"/>
                </Grid>

                <Grid Grid.Row="7" Grid.Column="1" Background="#D9DAD8" Margin="20,5" >
                    <StackPanel  Orientation="Horizontal">
                        <Image Source="/image/image5.png" Height="70" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock Text="Оперативная память" FontSize="25" VerticalAlignment="Center" Grid.Row="3" Margin="15"/>
                    </StackPanel>
                    <Button x:Name="Chois6" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="3"/>
                </Grid>

                <Grid Grid.Row="8" Grid.Column="1" Background="#D9DAD8" Margin="20,5" >
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/image/image2.png" Height="70" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock Text="Жесткий диск" FontSize="25" VerticalAlignment="Center" Grid.Row="3" Margin="15"/>
                    </StackPanel>
                    <Button x:Name="Chois7" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="8"/>
                </Grid>
                <Grid Background="#D9DAD8" Margin="20,5" >
                    <StackPanel  Orientation="Horizontal">
                        <Image Source="/image/image1.png" Height="45" HorizontalAlignment="Left" Margin="10"/>
                        <TextBlock Text="Графический процессор" FontSize="25" VerticalAlignment="Center" Grid.Row="3" Margin="15"/>
                    </StackPanel>
                    <Button x:Name="Chois8" Content="Выбрать" FontSize="20" Height="45" Width="90" HorizontalAlignment="Right" Margin="10, 5" Click="Chois_Click" Tag="2"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="0" Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    
                </Grid.RowDefinitions>

                <ListBox x:Name="DetailsChois" Grid.Row="0" Grid.Column="0" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate >
                        <DataTemplate>
                            <StackPanel Margin="15, 5" Orientation="Vertical">
                                <Image Height="100" Width="120" Source="{Binding image}"/>
                                <StackPanel Margin="5" HorizontalAlignment="Center" Width="200">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding name}" FontSize="20"/>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding opis}" FontSize="15"/>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding price}" FontSize="15"/>
                                </StackPanel>
                                <Button x:Name="Del" Content="Удалить" Width="75" Height="30" Click="Del_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                
                <ListBox x:Name="Error" Grid.Row="1" Grid.Column="0" d:ItemsSource="{d:SampleData ItemCount=5}" FontSize="20"/>
                <TextBlock x:Name="sum"  Grid.Row="2" Margin="15" FontSize="15"/>
                <Button Content="Сохранить" Grid.Row="2" Width="100" Height="50" FontSize="18" Margin="15"/>
            </Grid>
            
        </Grid>
    </ScrollViewer>
</Page>
