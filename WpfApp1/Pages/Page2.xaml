<Page x:Class="WpfApp1.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="2 цп" Grid.RowSpan="2"/>
        <Button x:Name="Back" Height="30" Width="50" Content="На главную" Margin="0,20,750,6"/>
        <ListBox x:Name="DetaelLstBx" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="15, 5" Orientation="Horizontal">
                        <Image Height="100" Width="120" Source="{Binding image}"/>
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <TextBlock TextWrapping="Wrap" Text="{Binding name}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding opis}" FontSize="15"/>
                        </StackPanel>
                        <Button x:Name="Buy" Content="Выбрать" Width="75" Height="30"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
