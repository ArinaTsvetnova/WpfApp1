<Page x:Class="WpfApp1.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2">

    <Grid>
        <StackPanel>
            <TextBlock Text="Вход в личный аккаунт" FontSize="40" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <TextBlock Text="Введите свою почту" FontSize="20" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <TextBox x:Name="email" FontSize="11" Foreground="#487994" Background="White" Height="40" Width="300" Margin="5"/>
            <TextBlock Text="Введите пароль" FontSize="20" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <TextBox x:Name="password" FontSize="11" Foreground="#487994" Background="White" Height="40" Width="300" Margin="5"/>
            <Button x:Name="vhod" Content="Вход" Width="100" Height="40" FontSize="14" Click="vhod_Click"/>
            <TextBlock Text="Не зарегистрированы? Ошибка. Регайся." FontSize="20" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <Button x:Name="reg" Content="Регистрация" Width="100" Height="40" FontSize="14" Click="regButton_Click"/>
            <Button x:Name="BackToMain" Content="На главное меню" Width="110" Height="40" HorizontalAlignment="Right" Click="BackToMain_Click"/>
        </StackPanel>
                
    </Grid>
</Page>
