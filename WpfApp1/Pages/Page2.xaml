<Page x:Class="WpfApp1.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2">

    <Grid Margin="0,0,10,-195">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox x:Name="Sort" Height="40" Width="100" SelectionChanged="Sort_SelectionChanged"/>
            <TextBox x:Name="Poisc" FontSize="25" Background="White" Height="40" Width="540" Grid.Row="0" TextChanged="Poisc_TextChanged" Margin="15" HorizontalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="DetaelLstBx" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="1">
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="15, 5" Orientation="Horizontal">
                        <Image Height="100" Width="120" Source="{Binding image}"/>
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <TextBlock TextWrapping="Wrap" Text="{Binding name}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding opis}" FontSize="15"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding price}" FontSize="15"/>
                        </StackPanel>
                        <Button x:Name="Buy" Content="Выбрать" Width="75" Height="30" Click="Buy_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Button x:Name="Back1" Content="Назад" Width="100" Height="50" Grid.Row="2" FontSize="20" Click="Back1_Click"/>
    </Grid>
</Page>
