<Page x:Class="WpfApp1.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="210"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="name" Text="{Binding film.Name}" FontSize="40" Foreground="#215756" HorizontalAlignment="Center" Grid.Row="0"/>
        <Image Source="{Binding film.Image}" Grid.Row="1" Height="200"/>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="rating" Text="{Binding film.Rating}" FontSize="20" Foreground="#215756" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ganre" Text="{Binding film.}" FontSize="20" Foreground="#215756" HorizontalAlignment="Center"/>
            <TextBlock x:Name="opisanie" Text="{Binding film.Info}" FontSize="20" Foreground="#215756" HorizontalAlignment="Center"/>
        </StackPanel>
        
    </Grid>
</Page>
