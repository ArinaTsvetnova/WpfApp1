<Page x:Class="WpfApp1.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page4">

    <Grid>
        <StackPanel>
            <TextBlock Text="Регистрация" FontSize="40" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <TextBlock Text="Введите своё имя" FontSize="20" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <TextBox x:Name="name" FontSize="11" Foreground="#487994" Background="White" Height="40" Width="300" Margin="5"/>
            <TextBlock Text="Введите свою почту" FontSize="20" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <TextBox x:Name="email" FontSize="11" Foreground="#487994" Background="White" Height="40" Width="300" Margin="5"/>
            <TextBlock Text="Введите пароль" FontSize="20" Foreground="#215756" HorizontalAlignment="Center" Margin="5"/>
            <TextBox x:Name="password" FontSize="11" Foreground="#487994" Background="White" Height="40" Width="300" Margin="5"/>
            <Button x:Name="reg" Content="Зарегистрировать" Width="130" Height="40" FontSize="14" Click="regButton_Click" Margin="5"/>
            <Button x:Name="BackToMain" Content="На главное меню" Width="110" Height="40" HorizontalAlignment="Right" Click="BackToMain_Click"/>
        </StackPanel>
    </Grid>
</Page>
