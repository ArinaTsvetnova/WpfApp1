<Page x:Class="WpfApp1.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page4">

    <Grid>
        <StackPanel>
            <ProgressBar Height="15" Minimum="0" Maximum="100" Value="100"/>
            <TextBlock Text="Машина мечты" FontSize="20"/>
            <TextBlock Text="Завершим оформление вашей заявки. Введите свои контактные данные" FontSize="14"/>
            <TextBlock Text="Имя" FontSize="14"/>
            <TextBox x:Name="Name" Height="20" Width="100" Margin="5"/>
            <TextBlock Text="Телефон" FontSize="14"/>
            <TextBox x:Name="Telephon" Height="20" Width="100" Margin="5"/>
            <TextBlock Text="Почта" FontSize="14"/>
            <TextBox x:Name="Mail" Height="20" Width="100" Margin="5"/>
            <!--<Button x:Name="Send" Content="Отправить" Margin="5" Click="ButtonSend_Click"/>-->
            <StackPanel Orientation="Horizontal" Height="20" Margin="0, 385, 0, 0">
                <Button x:Name="Button4GoBack" Content="Назад" Margin="580, 0, 0, 0" Click="Button4GoBack_Click"/>
                <Button x:Name="Button4GoForward" Content="Готово!" Margin="10, 0, 0, 0" Click="Button4GoForward_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
