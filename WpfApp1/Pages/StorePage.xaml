<Page x:Class="WpfApp1.Pages.StorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StorePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Магазин «Косметическая ложа»" FontSize="30" HorizontalAlignment="Center" Grid.Row="0"/>
        <Button Content="На главную" Height="40" Width="110" FontSize="14" Margin="5" HorizontalAlignment="Right" Click="Exit_Click" Grid.Row="0"/>
        <ComboBox x:Name="Sort" Height="40" Width="115" Margin="10, 5, 675, 5" Grid.Row="1" SelectionChanged="Sort_SelectionChanged"/>
        <TextBox x:Name="Poisc" FontSize="11" Foreground="#487994" Background="White" Height="40" Width="540" Grid.Row="1" TextChanged="Poisc_TextChanged"/>
        <ListBox x:Name="ProductListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="230" Height="450">
                        <Image Source="{Binding ImageUrl}" />
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Rating}"/>
                        <TextBlock Text="{Binding Description}"/>
                        <TextBlock Text="{Binding Price}"/>
                        <Button x:Name="See" Content="Подробнее" Width="90" Height="40" Click="See_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
