<Page x:Class="WpfApp1.Pages.PodrobPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PodrobPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Подробнее об услуге" FontSize="30" Margin="10" Grid.Row="0"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Back" Grid.Row="0" Content="Назад" Height="45" Width="120" FontSize="25" HorizontalAlignment="Right" Margin="10" Click="Back_Click"/>
            <Button x:Name="Start" Grid.Row="0" Content="На главную" Height="45" Width="150" FontSize="24" HorizontalAlignment="Right" Margin="10" Click="Start_Click"/>
        </StackPanel>
        <ListBox x:Name="Podrob" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=2}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="15, 5" Orientation="Horizontal">
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Users.FullName}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding ServiceTypes.Name}" FontSize="15"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding ServiceTypes.Phone}" FontSize="15"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding AppointmentDateTime}" FontSize="15"/>
                        </StackPanel>
                        <Button x:Name="Ok" Content="Завершить" Width="95" Height="30" FontSize="15" Margin="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
