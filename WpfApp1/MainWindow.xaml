<Window x:Class="WpfApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:WpfApp1"
    mc:Ignorable="d"
    Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <ProgressBar Height="15" Minimum="0" Maximum="100" Value="20"/>
            <TextBlock HorizontalAlignment="Center" Text="Машина мечты" Margin="5" FontSize="20"/>
            <TextBlock HorizontalAlignment="Center" Text="Здравствуйте, давайте скорее создадим машину вашей мечты" Margin="5" FontSize="14"/>
            <TextBlock HorizontalAlignment="Center" Text="Для начала выбирете модель вашего автомобиля" Margin="5" FontSize="14"/>
            <ComboBox x:Name="AutoModelComboBox" Margin="330, 5, 330, 5"/>
            <TextBlock HorizontalAlignment="Center" Text="На этом же этапе давайте определимся с типом двигателя вашего автомобиля" Margin="5" FontSize="14"/>
            <ComboBox x:Name="AutoTypeComboBox" Margin="330, 5, 330, 5"/>
            <StackPanel Orientation="Horizontal" Height="20" Margin="0, 210, 0, 0">
                <Button x:Name="ButtonGoBack" Content="Назад" Margin="580, 0, 0, 0" Height="20" Width="100" Click="ButtonGoBack_Click"/>
                <Button x:Name="ButtonGoForward" Content="Вперед" Margin="10, 0, 0, 0" Height="20" Width="100" Click="ButtonGoForward_Click"/>
            </StackPanel>
        </StackPanel>
        <Frame x:Name="MainFrame" Grid.Row="0" Navigated="MainFrame_OnNavigated" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>